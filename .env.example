# คัดลอกไฟล์นี้เป็น .env แล้วแก้ค่า (อย่า commit ไฟล์ .env)

DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME"

# คีย์ลับสำหรับเซ็น session cookie — สุ่มยาว ๆ เช่น: openssl rand -base64 32
AUTH_SECRET=""

# รหัสเชิญสำหรับสมัครเป็น "อาจารย์" (ผู้สมัครแบบนักเรียนไม่ต้องใช้)
# ถ้าไม่ตั้ง ระบบจะไม่เปิดให้สมัครเป็นอาจารย์
TEACHER_CODE=""
